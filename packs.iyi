# iyipacks: the directory of the iyi standard library and the iyi modules on
# GitHub, served from the catalog in SQLite. Run from the project directory:
#
#   iyi run packs.iyi                 # http://localhost:3000
#   PACKS_PORT=8080 iyi run packs.iyi
#
# The port is `-p`'s, else PACKS_PORT's, else PORT's, else 3000.
#
# DATABASE_URL names the catalog (default sqlite3:./data/packs.db); pending
# migrations in db/migrations are applied before the server listens.
module packs

import std/env::{ENV}
import db/db/core::{Database}
import db/db/errors::{DBError}
import miyrate/miyrate/errors::{MiyrateError}
import web/iyi_web/config::{config}
import web/iyi_web/dsl::*
import src/storage::{database_url, open_database}
import src/site::{site_routes}

if packs_port = ENV["PACKS_PORT"]?
  port = packs_port.to_i?
  unless port && port >= 0 && port <= 65535
    STDERR.puts "PACKS_PORT must be a port number between 0 and 65535, not " + packs_port.inspect
    exit 1
  end
  config.port = port
end

url = database_url
database = case opened = open_database(url)
           in Database then opened
           in MiyrateError, DBError
             STDERR.puts "cannot open the catalog at " + url + ": " + opened.message
             exit 1
           end

# Pages, JSON and the stylesheet go out zstd or gzip compressed.
config.compress = true

# The stylesheet and the script are linked with their content's version
# (`?v=`), so a versioned address never changes and is kept for a year.
static_headers do |env, path, info|
  versioned = env.request.query_string.starts_with?("v=")
  env.response.headers["Cache-Control"] = versioned ? "public, max-age=31536000, immutable" : "public, max-age=86400"
end

mount site_routes(database)

run
