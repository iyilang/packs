<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#141418" media="(prefers-color-scheme: dark)">
<title><%= meta.title %></title>
<meta name="description" content="<%= meta.description %>">
<% if canonical = meta.canonical -%>
<link rel="canonical" href="<%= canonical %>">
<meta property="og:url" content="<%= canonical %>">
<% end -%>
<% unless meta.index -%>
<meta name="robots" content="noindex, follow">
<% end -%>
<meta property="og:site_name" content="<%= SITE_NAME %>">
<meta property="og:type" content="website">
<meta property="og:locale" content="en_US">
<meta property="og:title" content="<%= meta.title %>">
<meta property="og:description" content="<%= meta.description %>">
<meta property="og:image" content="<%= SITE_URL %><%= SOCIAL_IMAGE %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="iyipacks, the iyi package directory">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/logo.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
<% unless meta.structured.empty? -%>
<script type="application/ld+json"><%= raw(meta.structured) %></script>
<% end -%>
<link rel="stylesheet" href="/style.css?v=<%= ASSET_VERSION %>">
<script src="/app.js?v=<%= ASSET_VERSION %>" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="shell">
<header>
<a class="logo" href="/" aria-label="iyipacks home"><span class="logo-mark"><%= raw(LOGO) %></span><span class="logo-name"><b>iyi</b>packs<span class="accent">.</span></span></a>
<nav aria-label="Main navigation">
<a href="/#catalog">Packages</a>
<a href="/#categories">Categories</a>
<a href="/about">About</a>
</nav>
<a class="header-link" href="https://iyi.dev/" target="_blank" rel="noopener noreferrer">iyi language ↗</a>
</header>
<main id="main"><%= content %></main>
<section class="closing">
<div class="eyebrow">THE FIRST PACKAGES. YOURS COULD BE NEXT.</div>
<h2>Build something <em>iyi.</em></h2>
<a class="text-link" href="https://github.com/iyilang/iyi" target="_blank" rel="noopener noreferrer">Meet the language ↗</a>
</section>
<footer>
<a class="footer-logo" href="/">iyi<span class="accent">packs.</span></a>
<span>A community-minded directory. Built with iyi.</span>
<a href="<%= REPO_URL %>" target="_blank" rel="noopener noreferrer">About the catalog ↗</a>
</footer>
</div>
</body>
</html>
